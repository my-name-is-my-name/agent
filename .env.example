# Explicit configuration. No production addresses or credentials are bundled.
MRO_AGENT_API_TOKEN=replace-with-a-long-random-service-token
# IDs supplied by the trusted Open WebUI Pipe. Pilot users must share corpus access.
MRO_AGENT_ALLOWED_USERS=replace-with-openwebui-user-id
MRO_AGENT_KB_URL=http://127.0.0.1:8121
MRO_AGENT_KB_TOKEN=
MRO_AGENT_LLM_URL=http://127.0.0.1:1234/v1
MRO_AGENT_LLM_MODEL=replace-with-local-model-name
MRO_AGENT_LLM_TOKEN=
MRO_AGENT_DATA_DIR=runtime
MRO_AGENT_HTTP_TIMEOUT=120

